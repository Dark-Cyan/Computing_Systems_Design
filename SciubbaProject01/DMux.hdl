// File name: projects/1/DMux.hdl
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    //'dmux' passes on the given input to one of the outputs based upon sel
    //namely, if sel is not 1, pass to a, and if it is 1, pass to b
    //dmux in sel = {a = in and not sel, b = in and sel}
    Not(in=sel, out=notsel);
    And(a=in, b=notsel, out=a);
    And(a=in, b=sel, out=b);
}