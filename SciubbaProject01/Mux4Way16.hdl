// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    //since the 'mux16' expression we already built can only handle two expressions, we can break down this large 'mux4way16' into smaller parts
    //first we can 'mux16' a and b using the ones place of sel (different between the two)
    //second we can 'mux16' c and d using the ones place of sel (different between the two)
    //finally, we can 'mux16' the two resulting expressions using the tens place of sel (different between the two)
    //mux16(a,b,c,d,sel) = mux16(mux16(a,b,sel[0]), mux16(c,d,sel[0]), sel[1])
    Mux16(a=a, b=b, sel=sel[0], out=e);
    Mux16(a=c, b=d, sel=sel[0], out=g);
    Mux16(a=e, b=g, sel=sel[1], out=out);
}