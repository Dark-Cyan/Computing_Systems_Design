// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    //similar to 'mux4way16' we can break the 'mux8way16' into smaller parts
    //first we can 'mux4way16' a, b, c, and d using the ones and tens place of sel (different between the four)
    //second we can 'mux4way16' e, f, g, and h using the ones and tens place of sel (different between the four)
    //finally, we can 'mux16' the two resulting expressions using the hundreds place of sel (different between the two)
    //mux4way16(a,b,c,d,e,f,g,h,sel) = mux16(mux4way16(a,b,c,d,sel[0..1], mux4way16(e,f,g,h,sel[0..1]), sel[2])
    Mux4Way16(a=a, b=b, c=c, d=d, sel=sel[0..1], out=i);
    Mux4Way16(a=e, b=f, c=g, d=h, sel=sel[0..1], out=j);
    Mux16(a=i, b=j, sel=sel[2], out=out);
}