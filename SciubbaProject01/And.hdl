// File name: projects/1/And.hdl
/**
 * And gate:
 * if (a and b) out = 1, else out = 0 
 */
CHIP And {
    IN a, b;
    OUT out;
    
    PARTS:
    //'nand' is the 'not' expression of 'and', so we can 'nand' the input and then 'not' the resulting value
    //a and b = not(a nand b) 
    Nand(a=a, b=b, out=nandout);
    Not(in=nandout, out=out);
}