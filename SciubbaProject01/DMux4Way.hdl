// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    //since the 'dmux' expression we already built can only handle outputting two expressions, we can break down this large 'dmux4way' into smaller parts
    //first we can 'dmux' in using the ones place of sel
    //second we can 'dmux' the two resulting expressions using the tens place of sel (all together form 4 pathways)
    //dmux(in,sel) = dmux(dmux(in,sel[0]), sel[1])
    DMux(in=in, sel=sel[0], a=ac, b=bd);
    DMux(in=ac, sel=sel[1], a=a, b=c);
    DMux(in=bd, sel=sel[1], a=b, b=d);
}