// File name: projects/1/Not.hdl
/**
 * Not gate:
 * if (in) out = 0, else out = 1
 */
CHIP Not {
    IN in;
    OUT out;

    PARTS:
    //'nand' inputs can only be both true or false here (since one input variable) which becomes opposite expression due to 'nand' simplifying to 'not'
    //not in = not(in and in) = in nand in
    Nand(a=in, b=in, out=out); 
}