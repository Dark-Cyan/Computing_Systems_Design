// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    //since the 'or' expression we already built can only handle two expressions, we can break down this large 'or' into many smaller ones
    //in[0] or in[1] or in[2] or in[3] or in[4] or in[5] or in[6] or in[7]
    //= (in[0] or in[1]) or (in[2] or in[3]) or (in[4] or in[5]) or (in[6] or in[7])
    Or(a=in[0], b=in[1], out=or1);
    Or(a=in[2], b=in[3], out=or2);
    Or(a=in[4], b=in[5], out=or3);
    Or(a=in[6], b=in[7], out=or4);
    Or(a=or1, b=or2, out=or5);
    Or(a=or3, b=or4, out=or6);
    Or(a=or5, b=or6, out=out);
}