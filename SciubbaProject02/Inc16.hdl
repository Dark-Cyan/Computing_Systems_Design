// File name: projects/2/Inc16.hdl
/**
 * 16-bit incrementer:
 * out = in + 1
 */
CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
    //to increment a 16-bit variable, we can simply 'Add16' the value 1
    Add16(a=in, b[1..15]=false, b[0]=true, out=out);
}