// File name: projects/2/HalfAdder.hdl
/**
 * Computes the sum of two bits.
 */
CHIP HalfAdder {
    IN a, b;    // 1-bit inputs
    OUT sum,    // Right bit of a + b 
        carry;  // Left bit of a + b

    PARTS:
    //if only one bit is true: sum is true (1 + 0 = 01)(0 + 1 = 01)
    Xor(a=a, b=b, out=sum);
    //if both bits are true: carry is true (1 + 1 = 10)
    And(a=a, b=b, out=carry);
}