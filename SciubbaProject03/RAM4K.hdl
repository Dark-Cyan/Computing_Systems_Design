// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    //'Dmux8Way' passes load to correct 'RAM512'
    DMux8Way(in=load, sel=address[9..11], a=address1, b=address2, c=address3, d=address4, e=address5, f=address6, g=address7, h=address8);
    //'RAM512' further passes load to correct smaller RAM units until correct address is changed
    RAM512(in=in, load=address1, address=address[0..8], out=ram5121);
    RAM512(in=in, load=address2, address=address[0..8], out=ram5122);
    RAM512(in=in, load=address3, address=address[0..8], out=ram5123);
    RAM512(in=in, load=address4, address=address[0..8], out=ram5124);
    RAM512(in=in, load=address5, address=address[0..8], out=ram5125);
    RAM512(in=in, load=address6, address=address[0..8], out=ram5126);
    RAM512(in=in, load=address7, address=address[0..8], out=ram5127);
    RAM512(in=in, load=address8, address=address[0..8], out=ram5128);
    //'Mux8Way16' finds final value at address to output it
    Mux8Way16(a=ram5121, b=ram5122, c=ram5123, d=ram5124, e=ram5125, f=ram5126, g=ram5127, h=ram5128, sel=address[9..11], out=out);
}